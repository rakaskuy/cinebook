NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged Service Role Key (Hanya digunakan di sisi server/serverless backend, JANGAN diexpose ke client)
