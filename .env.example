# =============================================================================
# CINEMANIK 2026 - ENVIRONMENT VARIABLES TEMPLATE (UNTUK VERCEL & PC SERVER)
# =============================================================================
# Masukkan variabel di bawah ini pada Vercel Dashboard: Project -> Settings -> Environment Variables

# 1. Supabase Public Config (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://snpqntgxshhaqulgngru.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Private Service Role Key (Hanya Server-side, JANGAN bocorkan ke client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Super Admin & Domain Config
# Ganti NEXT_PUBLIC_APP_URL dengan domain Vercel Anda saat deploy, contoh: https://cinemanik.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=kenxfear@gmail.com

# 4. Cron Secret Token (Untuk memproteksi endpoint auto-expire 24 jam)
CRON_SECRET=cinemanik_cron_tzkd08g5ez

# 5. Opsi Pengiriman Email (Pilih salah satu atau kombinasikan):
# A) JALUR PC SERVER (Self-Hosted di PC 192.168.1.7 via Cloudflare Tunnel)
# Saat deploy di Vercel, pasang variabel ini agar Vercel mengoper pengiriman email ke PC Anda:
EXTERNAL_MAILER_URL=https://cinemanik.xra.my.id/api/resend-ticket-email
MAILER_SECRET=cinemanik_mailer_auth_token_2026

# B) SMTP PRIBADI DI PC (Gmail SMTP / Postfix Lokal)
# Jika diset di .env.local PC Anda:
USE_LOCAL_POSTFIX=true
# Atau Gmail SMTP (500 email/hari gratis):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-app-password

# C) Resend API (Sebagai Backup / Fallback)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=Cinemanik OSIS <onboarding@resend.dev>
